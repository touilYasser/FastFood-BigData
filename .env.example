# Valeurs pour un environnement de développement local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
JUPYTER_TOKEN=fastfood

# Durée pendant laquelle les notebooks RDD et SQL laissent Spark UI ouvert en fin de calcul
FASTFOOD_UI_HOLD_SECONDS=0

# Ports hôte à personnaliser si un autre projet les utilise déjà
# SPARK_MASTER_PORT=7077
# SPARK_MASTER_UI_PORT=8080
# SPARK_WORKER_1_UI_PORT=8081
# SPARK_WORKER_2_UI_PORT=8082
# KAFKA_PORT=9092
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Docker choisit un port libre pour Jupyter. Decommenter pour fixer le port.
# JUPYTER_PORT=8888
# SPARK_APP_UI_PORT=4040
